{
  "info": {
    "name": "Student Import",
    "description": "Tests for the student CSV import endpoint with dry-run support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost",
      "type": "string"
    },
    {
      "key": "tenant_domain",
      "value": "demo.cbt.local",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Dry Run - Valid CSV",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('can_proceed is true', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.be.true;",
              "    pm.expect(body.data.can_proceed).to.be.true;",
              "    pm.expect(body.data.dry_run).to.be.true;",
              "    pm.expect(body.data.total_rows).to.eql(5);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "XMLHttpRequest"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "students-valid.csv"
            },
            {
              "key": "dry_run",
              "value": "true"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/students/import",
          "host": ["{{base_url}}"],
          "path": ["api", "students", "import"]
        }
      }
    },
    {
      "name": "Dry Run - Missing Headers",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 422', () => pm.response.to.have.status(422));",
              "pm.test('returns missing_headers', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.be.false;",
              "    pm.expect(body.errors.missing_headers).to.include('last_name');",
              "    pm.expect(body.errors.missing_headers).to.include('class_level');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "XMLHttpRequest"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "students-missing-headers.csv"
            },
            {
              "key": "dry_run",
              "value": "true"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/students/import",
          "host": ["{{base_url}}"],
          "path": ["api", "students", "import"]
        }
      }
    },
    {
      "name": "Dry Run - Row Errors",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 422', () => pm.response.to.have.status(422));",
              "pm.test('returns per-row errors', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.be.false;",
              "    pm.expect(body.errors.length).to.be.at.least(1);",
              "    pm.expect(body.errors[0]).to.have.property('row');",
              "    pm.expect(body.errors[0]).to.have.property('errors');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "XMLHttpRequest"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "students-row-errors.csv"
            },
            {
              "key": "dry_run",
              "value": "true"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/students/import",
          "host": ["{{base_url}}"],
          "path": ["api", "students", "import"]
        }
      }
    },
    {
      "name": "Dry Run - Empty CSV",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 422', () => pm.response.to.have.status(422));",
              "pm.test('returns empty csv error', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.be.false;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "XMLHttpRequest"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "students-empty.csv"
            },
            {
              "key": "dry_run",
              "value": "true"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/students/import",
          "host": ["{{base_url}}"],
          "path": ["api", "students", "import"]
        }
      }
    },
    {
      "name": "Import - Skip Duplicates (run after valid import)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('returns import counts', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.be.true;",
              "    pm.expect(body.data.imported).to.be.a('number');",
              "    pm.expect(body.message).to.include('imported');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "XMLHttpRequest"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "students-valid.csv"
            },
            {
              "key": "dry_run",
              "value": "false"
            },
            {
              "key": "overwrite_existing",
              "value": "skip"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/students/import",
          "host": ["{{base_url}}"],
          "path": ["api", "students", "import"]
        }
      }
    },
    {
      "name": "Import - Update Duplicates (run after valid import)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('returns import counts with updated', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.be.true;",
              "    pm.expect(body.data.updated).to.be.at.least(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "XMLHttpRequest"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "students-duplicates.csv"
            },
            {
              "key": "dry_run",
              "value": "false"
            },
            {
              "key": "overwrite_existing",
              "value": "update"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/students/import",
          "host": ["{{base_url}}"],
          "path": ["api", "students", "import"]
        }
      }
    }
  ]
}
